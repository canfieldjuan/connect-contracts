{
  "protocol_version": 2,
  "instance_id": "11111111-1111-4111-8111-111111111111",
  "app": {
    "id": "document-summarizer",
    "name": "Document Summarizer",
    "version": "0.2.0"
  },
  "capabilities": [
    {
      "id": "document.translate",
      "version": "1.0",
      "action": {
        "label": "Translate",
        "description": "Create a local translation."
      },
      "accepts": [{ "media_type": "application/pdf", "max_bytes": 52428800 }],
      "produces": ["text/plain"],
      "parameters": [
        {
          "name": "target-language",
          "value_type": "string",
          "required": true,
          "label": "Target language",
          "description": "Language to produce."
        },
        {
          "name": "target-language",
          "value_type": "string",
          "required": false,
          "label": "Fallback language",
          "description": "Language to use if the first is unavailable."
        }
      ],
      "effects": { "external": false, "confirmation_required": false }
    }
  ]
