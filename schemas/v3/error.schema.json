{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-connect.invalid/schemas/v3/error.schema.json",
  "title": "Local Connect v3 HTTP Error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "error"
  ],
  "properties": {
    "protocol_version": {
      "const": 3
    },
    "error": {
      "$ref": "#/$defs/error"
    }
  },
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+(?![\\s\\S])",
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "PROVIDER_BUSY"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "retryable": {
                "const": true
              }
            },
            "required": [
              "retryable"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "OUTPUT_BUSY",
                  "OUTPUT_NOT_READY"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "retryable": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "OUTPUT_NOT_FOUND",
                  "OUTPUT_UNAVAILABLE",
                  "JOB_NOT_FOUND",
                  "MALFORMED_REQUEST"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "retryable": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
