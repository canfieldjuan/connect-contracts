{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-connect.invalid/schemas/v1/job-request.schema.json",
  "title": "Local Connect v1 Job Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "job_id", "capability", "inputs"],
  "properties": {
    "protocol_version": { "const": 1 },
    "job_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 100 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "media_type", "byte_size", "sha256", "display_name", "source_app_id"],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "media_type": { "type": "string", "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$", "maxLength": 127 },
          "byte_size": { "type": "integer", "minimum": 1, "maximum": 104857600 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "source_app_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 100 }
        }
      }
    }
  }
}
