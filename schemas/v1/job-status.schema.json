{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-connect.invalid/schemas/v1/job-status.schema.json",
  "title": "Local Connect v1 Job Status",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "job_id", "capability", "provider", "status", "created_at", "updated_at", "input_artifacts"],
  "properties": {
    "protocol_version": { "const": 1 },
    "job_id": { "$ref": "#/$defs/uuid" },
    "capability": { "$ref": "#/$defs/capability" },
    "provider": { "$ref": "#/$defs/provider" },
    "status": { "enum": ["accepted", "processing", "completed", "failed"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/artifact_provenance" }
    },
    "result": { "$ref": "#/$defs/result" },
    "error": { "$ref": "#/$defs/job_error" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": { "required": ["result"], "not": { "required": ["error"] } }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": { "required": ["error"], "not": { "required": ["result"] } }
    },
    {
      "if": { "properties": { "status": { "enum": ["accepted", "processing"] } }, "required": ["status"] },
      "then": { "not": { "anyOf": [{ "required": ["result"] }, { "required": ["error"] }] } }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 100 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_id", "instance_id"],
      "properties": {
        "app_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 100 },
        "instance_id": { "$ref": "#/$defs/uuid" }
      }
    },
    "artifact_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "media_type", "byte_size", "sha256"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/uuid" },
        "media_type": { "type": "string", "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$", "maxLength": 127 },
        "byte_size": { "type": "integer", "minimum": 0, "maximum": 104857600 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 100 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary_version", "text", "warnings", "input_artifact"],
      "properties": {
        "summary_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1048576 },
        "warnings": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/warning" }
        },
        "input_artifact": { "$ref": "#/$defs/artifact_provenance" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "media_type", "byte_size", "sha256", "content"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/uuid" },
        "media_type": { "const": "application/vnd.local-connect.document-summary+json" },
        "byte_size": { "type": "integer", "minimum": 1, "maximum": 2097152 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "content": { "$ref": "#/$defs/summary" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputs"],
      "properties": {
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/output" }
        }
      }
    },
    "job_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 100 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
