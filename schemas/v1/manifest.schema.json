{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-connect.invalid/schemas/v1/manifest.schema.json",
  "title": "Local Connect v1 Provider Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "instance_id", "app", "capabilities"],
  "properties": {
    "protocol_version": { "const": 1 },
    "instance_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 100 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "accepts", "produces"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 100 },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
          "accepts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["media_type", "max_bytes"],
              "properties": {
                "media_type": { "type": "string", "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$", "maxLength": 127 },
                "max_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 }
              }
            }
          },
          "produces": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": { "type": "string", "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$", "maxLength": 127 }
          }
        }
      }
    }
  }
}
