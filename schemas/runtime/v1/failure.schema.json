{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-connect.invalid/schemas/runtime/v1/failure.schema.json",
  "title": "Local Connect model host terminal failure v1 (ADR-0011 failure.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "code",
    "start_id",
    "profile_id",
    "host",
    "at",
    "log_tail"
  ],
  "properties": {
    "protocol": {
      "const": 1
    },
    "code": {
      "enum": [
        "PROFILE_INVALID",
        "RUNTIME_FILES_INVALID",
        "STORE_UNSUPPORTED",
        "NO_TIER",
        "GPU_BUSY",
        "SERVER_FAILED"
      ]
    },
    "start_id": {
      "$ref": "#/$defs/uuid4"
    },
    "profile_id": {
      "$ref": "#/$defs/sha256"
    },
    "host": {
      "$ref": "#/$defs/identity"
    },
    "at": {
      "$ref": "#/$defs/timestamp"
    },
    "log_tail": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "uuid4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "format": "date-time"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "start_time",
        "boot_id"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "start_time": {
          "type": "integer",
          "minimum": 0
        },
        "boot_id": {
          "$ref": "#/$defs/uuid"
        }
      }
    }
  }
}
