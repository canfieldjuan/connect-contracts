{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-connect.invalid/schemas/runtime/v1/server.schema.json",
  "title": "Local Connect model host registration v1 (ADR-0011 server.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "state",
    "start_id",
    "ready_by",
    "profile_id",
    "tier",
    "device",
    "host",
    "server",
    "socket_path",
    "model_sha256",
    "context_tokens",
    "build_commit",
    "chat_template_sha256"
  ],
  "properties": {
    "protocol": {
      "const": 1
    },
    "state": {
      "enum": [
        "starting",
        "ready",
        "stopping"
      ]
    },
    "start_id": {
      "$ref": "#/$defs/uuid4"
    },
    "ready_by": {
      "$ref": "#/$defs/timestamp"
    },
    "profile_id": {
      "$ref": "#/$defs/sha256"
    },
    "tier": {},
    "device": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "host": {
      "$ref": "#/$defs/identity"
    },
    "server": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pid",
            "start_time"
          ],
          "properties": {
            "pid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4194304
            },
            "start_time": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "socket_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "model_sha256": {},
    "context_tokens": {},
    "build_commit": {},
    "chat_template_sha256": {}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "uuid4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "format": "date-time"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "start_time",
        "boot_id"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "start_time": {
          "type": "integer",
          "minimum": 0
        },
        "boot_id": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "selected_runtime": {
      "type": "object",
      "properties": {
        "tier": {
          "enum": [
            "gpu-cuda",
            "gpu-vulkan",
            "cpu"
          ]
        },
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "context_tokens": {
          "const": 32768
        },
        "build_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "chat_template_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/selected_runtime"
    },
    {
      "properties": {
        "state": {
          "const": "starting"
        },
        "tier": {
          "type": "null"
        },
        "model_sha256": {
          "type": "null"
        },
        "context_tokens": {
          "type": "null"
        },
        "build_commit": {
          "type": "null"
        },
        "chat_template_sha256": {
          "type": "null"
        },
        "device": {
          "type": "null"
        },
        "server": {
          "type": "null"
        }
      }
    }
  ]
}
