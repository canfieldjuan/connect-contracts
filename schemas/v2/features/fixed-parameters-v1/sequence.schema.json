{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-connect.invalid/schemas/v2/features/fixed-parameters-v1/sequence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "initial_manifest",
    "events"
  ],
  "properties": {
    "initial_manifest": {
      "$ref": "https://local-connect.invalid/schemas/v2/features/fixed-parameters-v1/manifest.schema.json"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "manifest"
            ],
            "properties": {
              "kind": {
                "const": "rotate"
              },
              "manifest": {
                "$ref": "https://local-connect.invalid/schemas/v2/features/fixed-parameters-v1/manifest.schema.json"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "request"
            ],
            "properties": {
              "kind": {
                "const": "submit"
              },
              "request": {
                "$ref": "https://local-connect.invalid/schemas/v2/job-request.schema.json"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "exchange"
            ],
            "properties": {
              "kind": {
                "const": "discover"
              },
              "exchange": {
                "$ref": "https://local-connect.invalid/schemas/v2/features/fixed-parameters-v1/exchange.schema.json"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "job_id"
            ],
            "properties": {
              "kind": {
                "const": "mark_failed"
              },
              "job_id": {
                "$ref": "https://local-connect.invalid/schemas/v2/job-request.schema.json#/$defs/uuid"
              }
            }
          }
        ]
      }
    }
  }
}
