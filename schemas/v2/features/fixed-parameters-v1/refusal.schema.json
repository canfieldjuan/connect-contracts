{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-connect.invalid/schemas/v2/features/fixed-parameters-v1/refusal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "http_status",
    "body"
  ],
  "properties": {
    "http_status": {
      "const": 409
    },
    "body": {
      "allOf": [
        {
          "$ref": "https://local-connect.invalid/schemas/v2/error.schema.json"
        },
        {
          "properties": {
            "error": {
              "properties": {
                "code": {
                  "const": "FIXED_PARAMETER_MISMATCH"
                },
                "retryable": {
                  "const": false
                }
              }
            }
          }
        }
      ]
    }
  }
}
