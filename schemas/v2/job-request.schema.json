{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-connect.invalid/schemas/v2/job-request.schema.json",
  "title": "Local Connect v2 Job Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "job_id", "capability", "inputs", "parameters"],
  "properties": {
    "protocol_version": { "const": 2 },
    "job_id": { "$ref": "#/$defs/uuid" },
    "capability": { "$ref": "#/$defs/capability" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/input_artifact" }
    },
    "parameters": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "maxLength": 1000 },
          { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
          { "type": "boolean" }
        ]
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 100
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$",
      "maxLength": 127
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      }
    },
    "input_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "media_type", "byte_size", "sha256", "display_name", "source_app_id"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/uuid" },
        "media_type": { "$ref": "#/$defs/media_type" },
        "byte_size": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "source_app_id": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
