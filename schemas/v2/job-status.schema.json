{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-connect.invalid/schemas/v2/job-status.schema.json",
  "title": "Local Connect v2 Job Status",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "job_id", "capability", "provider", "status", "created_at", "updated_at", "input_artifacts"],
  "properties": {
    "protocol_version": { "const": 2 },
    "job_id": { "$ref": "#/$defs/uuid" },
    "capability": { "$ref": "#/$defs/capability" },
    "provider": { "$ref": "#/$defs/provider" },
    "status": { "enum": ["accepted", "processing", "completed", "failed"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/artifact_provenance" }
    },
    "result": { "$ref": "#/$defs/result" },
    "error": { "$ref": "#/$defs/error" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": { "required": ["result"], "not": { "required": ["error"] } }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": { "required": ["error"], "not": { "required": ["result"] } }
    },
    {
      "if": { "properties": { "status": { "enum": ["accepted", "processing"] } }, "required": ["status"] },
      "then": { "not": { "anyOf": [{ "required": ["result"] }, { "required": ["error"] }] } }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 100
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$",
      "maxLength": 127
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_id", "instance_id"],
      "properties": {
        "app_id": { "$ref": "#/$defs/identifier" },
        "instance_id": { "$ref": "#/$defs/uuid" }
      }
    },
    "artifact_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "media_type", "byte_size", "sha256"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/uuid" },
        "media_type": { "$ref": "#/$defs/media_type" },
        "byte_size": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "media_type", "display_name", "byte_size", "sha256", "payload_base64"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/uuid" },
        "media_type": { "$ref": "#/$defs/media_type" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "byte_size": { "type": "integer", "minimum": 0, "maximum": 2097152 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "payload_base64": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2796204,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputs"],
      "properties": {
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/output" }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 100 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
